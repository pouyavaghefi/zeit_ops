#!/usr/bin/env bash
# ZeitOps domain aliases for existing Laravel/LAMP deployments.
# Root-owned and invoked only through the restricted `zeitops` management account.
set -Eeuo pipefail
umask 027
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

error() { printf 'ZEITOPS_DOMAIN_ERROR: %s\n' "$*" >&2; exit 1; }
log() { printf '[%s] site=%s domain=%s %s\n' "$(date -u +%FT%TZ)" "$SITE_ID" "$DOMAIN" "$*" >> "/var/log/zeitops-domains-${SITE_ID}.log"; }
[[ "$(id -u)" == 0 ]] || error 'Root helper required.'
[[ "$#" == 4 ]] || error 'Expected action site-id domain verification-token.'
ACTION="$1"; SITE_ID="$2"; DOMAIN="$3"; TOKEN="$4"
[[ "$ACTION" == issue || "$ACTION" == remove ]] || error 'Unsupported action.'
[[ "$SITE_ID" =~ ^[1-9][0-9]{0,8}$ ]] || error 'Invalid site ID.'
[[ ${#DOMAIN} -le 253 && "$DOMAIN" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,63}$ ]] || error 'Invalid lowercase domain.'
[[ ! "$DOMAIN" =~ \.\. && ! "$DOMAIN" =~ -- && ! "$DOMAIN" =~ \.\- && ! "$DOMAIN" =~ \-\. ]] || error 'Invalid domain labels.'
[[ "$TOKEN" =~ ^[a-z0-9]{64}$ ]] || error 'Invalid verification token.'
SITE="/srv/zeitops/sites/${SITE_ID}"
CURRENT="${SITE}/current"
PRIMARY_FILE="/etc/zeitops/sites/${SITE_ID}.domain"
CONF="/etc/apache2/sites-available/zeitops-alias-${SITE_ID}-${DOMAIN}.conf"
ACME="/var/lib/zeitops/acme/${SITE_ID}"
SOCKET="/run/php/zeitops-${SITE_ID}.sock"
[[ -f "$PRIMARY_FILE" && ! -L "$PRIMARY_FILE" ]] || error 'Primary site not activated.'
PRIMARY="$(cat "$PRIMARY_FILE")"
[[ "$PRIMARY" != "$DOMAIN" ]] || error 'Primary domain is managed through website deployment.'
[[ -L "$CURRENT" && -d "$CURRENT/public" ]] || error 'No active site release.'
[[ -S "$SOCKET" ]] || error 'PHP-FPM socket is not available.'
command -v certbot >/dev/null || error 'Certbot not installed.'
command -v dig >/dev/null || error 'dig is required (dnsutils package).'
install -d -m 755 -o root -g root /var/lib/zeitops/acme
install -d -m 755 -o root -g root "$ACME/.well-known/acme-challenge"
exec 9>"/run/lock/zeitops-domain-${SITE_ID}.lock"
flock -w 30 9 || error 'Another domain operation is in progress.'
# Avoid alias collisions with other enabled Apache virtualhosts.
if [[ "$ACTION" == issue ]]; then
    [[ -f "$CONF" && -L "$CONF" ]] && error 'Unsafe Apache configuration.'
    domain_regex="${DOMAIN//./\\.}"
    if grep -R -h -E '^[[:space:]]*Server(Name|Alias)[[:space:]]+' /etc/apache2/sites-enabled/ 2>/dev/null \
        | grep -Eiq "^[[:space:]]*Server(Name|Alias)[[:space:]]+${domain_regex}([[:space:]]|$)"; then
        [[ -f "$CONF" ]] || error 'Domain is already configured in another vhost.'
    fi
    DNS_ADDRESSES="$(dig +short A "$DOMAIN" | grep -E '^[0-9]+(\.[0-9]+){3}$' || true)"
    LOCAL_ADDRESSES="$(ip -4 -o addr show scope global | awk '{split($4,a,"/");print a[1]}' || true)"
    MATCH=false
    while IFS= read -r address; do
      [[ -n "$address" ]] || continue
      if grep -qxF "$address" <<< "$LOCAL_ADDRESSES"; then MATCH=true; break; fi
    done <<< "$DNS_ADDRESSES"
    [[ "$MATCH" == true ]] || error 'DNS A record does not resolve to a local VPS IPv4 address.'
    TXT="$(dig +short TXT "_zeitops-verify.${DOMAIN}" | tr -d '"' | tr -d ' ' || true)"
    grep -qxF "zeitops-verification=${TOKEN}" <<< "$TXT" || error 'DNS TXT ownership verification failed.'
    # Use a separate alias vhost: the primary deployment helper may rewrite its own vhost.
    [[ ! -L "$CONF" ]] || error 'Symlinked alias vhost refused.'
    HTTP_TEMP="$(mktemp /etc/apache2/sites-available/.zeitops-domain-XXXXXX)"
    chmod 644 "$HTTP_TEMP"
    cat > "$HTTP_TEMP" <<EOF
<VirtualHost *:80>
    ServerName ${DOMAIN}
    DocumentRoot ${CURRENT}/public
    Alias /.well-known/acme-challenge/ "${ACME}/.well-known/acme-challenge/"
    <Directory "${ACME}/.well-known/acme-challenge/">
        Require all granted
        AllowOverride None
        Options None
    </Directory>
    <Directory "${CURRENT}/public">
        Require all granted
        AllowOverride All
        Options FollowSymLinks
    </Directory>
    <FilesMatch "\\.php$">
        SetHandler "proxy:unix:${SOCKET}|fcgi://localhost/"
    </FilesMatch>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://${DOMAIN}%{REQUEST_URI} [R=301,L,NE]
    ErrorLog \${APACHE_LOG_DIR}/zeitops-${SITE_ID}-alias-error.log
    CustomLog \${APACHE_LOG_DIR}/zeitops-${SITE_ID}-alias-access.log combined
</VirtualHost>
EOF
    [[ ! -f "$CONF" ]] || cp -a "$CONF" "${HTTP_TEMP}.old"
    mv -f "$HTTP_TEMP" "$CONF"
    a2enmod rewrite >/dev/null
    a2ensite "$(basename "$CONF")" >/dev/null
    apache2ctl configtest >/dev/null || error 'Apache alias HTTP config invalid.'
    systemctl reload apache2
    log 'domain HTTP vhost provisioned; requesting certificate'
    if ! certbot certonly --webroot -w "$ACME" --non-interactive --agree-tos \
        --register-unsafely-without-email --cert-name "zeitops-${SITE_ID}-${DOMAIN}" -d "$DOMAIN" \
        >> "/var/log/zeitops-domains-${SITE_ID}.log" 2>&1; then
        if [[ -f "${HTTP_TEMP}.old" ]]; then
            mv -f "${HTTP_TEMP}.old" "$CONF"
        else
            a2dissite "$(basename "$CONF")" >/dev/null || true
            rm -f "$CONF"
        fi
        systemctl reload apache2 || true
        error 'Certificate issuance failed. Check the domain VPS log.'
    fi
    rm -f "${HTTP_TEMP}.old"
    CERT="/etc/letsencrypt/live/zeitops-${SITE_ID}-${DOMAIN}/fullchain.pem"
    KEY="/etc/letsencrypt/live/zeitops-${SITE_ID}-${DOMAIN}/privkey.pem"
    [[ -s "$CERT" && -s "$KEY" ]] || error 'Issued certificate files missing.'
    cat >> "$CONF" <<EOF

<VirtualHost *:443>
    ServerName ${DOMAIN}
    DocumentRoot ${CURRENT}/public
    SSLEngine on
    SSLCertificateFile ${CERT}
    SSLCertificateKeyFile ${KEY}
    <Directory "${CURRENT}/public">
        Require all granted
        AllowOverride All
        Options FollowSymLinks
    </Directory>
    <FilesMatch "\\.php$">
        SetHandler "proxy:unix:${SOCKET}|fcgi://localhost/"
    </FilesMatch>
    ErrorLog \${APACHE_LOG_DIR}/zeitops-${SITE_ID}-alias-error.log
    CustomLog \${APACHE_LOG_DIR}/zeitops-${SITE_ID}-alias-access.log combined
</VirtualHost>
EOF
    a2enmod ssl >/dev/null
    apache2ctl configtest >/dev/null || error 'Apache HTTPS config invalid.'
    systemctl reload apache2
    CODE="$(curl -k -sS -o /dev/null --max-time 20 --resolve "${DOMAIN}:443:127.0.0.1" -w '%{http_code}' "https://${DOMAIN}/" || true)"
    [[ "$CODE" =~ ^[23][0-9]{2}$ ]] || error "Local HTTPS health check failed (HTTP ${CODE:-unknown})."
    # Validate that the presented certificate matches the domain (not merely any HTTPS cert).
    curl -fsSI --max-time 20 --resolve "${DOMAIN}:443:127.0.0.1" "https://${DOMAIN}/" >/dev/null || error 'HTTPS certificate verification failed.'
    EXPIRES="$(openssl x509 -in "$CERT" -noout -enddate | cut -d= -f2-)"
    EXPIRES_DATE="$(date -u -d "$EXPIRES" +%F)"
    log "certificate active; expires=$EXPIRES_DATE"
    echo "ZEITOPS_DOMAIN_HTTPS_READY expires=${EXPIRES_DATE}"
else
    [[ ! -L "$CONF" ]] || error 'Symlinked alias vhost refused.'
    # Delete only the alias-specific certificate, never the primary site's certificate.
    if [[ -f "$CONF" ]]; then
        a2dissite "$(basename "$CONF")" >/dev/null || true
        rm -f -- "$CONF"
        apache2ctl configtest >/dev/null || error 'Apache configuration invalid after alias removal.'
        systemctl reload apache2
    fi
    if [[ -d "/etc/letsencrypt/live/zeitops-${SITE_ID}-${DOMAIN}" ]]; then
        certbot delete --non-interactive --cert-name "zeitops-${SITE_ID}-${DOMAIN}" \
            >> "/var/log/zeitops-domains-${SITE_ID}.log" 2>&1 || error 'Alias removed but certificate cleanup failed.'
    fi
    log 'alias vhost and its certificate removed'
    echo 'ZEITOPS_DOMAIN_REMOVED'
fi
